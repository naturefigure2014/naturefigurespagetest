	<div id="collection_page">
		<div id="collection_page_head">
			<img height="68" src="img/mizubenonakama_header.png" width="760" /><br/>
		<table style="width: 100%">
			<tr>
				<td >
				<img height="225" src="img/mizubenonakama018.jpg" width="760" /></td>
