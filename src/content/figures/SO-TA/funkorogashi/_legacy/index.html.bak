			-->
			<tr><th id="8">ディスプレイポップ</th></tr>
			<tr><td><a href="img/funkorogashiDP.jpg">
				<img height="283" src="img/funkorogashiDP_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/SO-TA/funkorogashi/img/funkorogashiDP.jpg" --></a></td></tr>
