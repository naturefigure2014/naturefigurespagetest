			<tr><td><a href="img/goliathus028.jpg">
				<img height="283" src="img/goliathus028_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/SO-TA/goliathus/img/goliathus028.jpg" --></a><a href="img/goliathus029.jpg"><img height="283" src="img/goliathus029_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/SO-TA/goliathus/img/goliathus029.jpg" --></a></td></tr>
