					<td>
					<a href="img/genn_ebikani_kai040.jpg">
					<img height="283" src="img/genn_ebikani_kai040_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/yujin/ebi_kani_kai/img/genn_ebikani_kai040.jpg" --></a></td>
