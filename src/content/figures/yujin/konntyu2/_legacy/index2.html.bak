	<div id="collection_page">
		<div id="collection_page_head">
		<h4>ユージン　原色図鑑シリーズ２３　原色日本昆虫図鑑II</h4>
			<p>
			原色日本昆虫図鑑IIのレビューページの2ページ目。<br />
			１ページ目は<a href="index.html">コチラ</a>。<br />
			</p>
		</div>
		<div id="collection_page_main">
		<!-- ↓ラインナップ一覧サムネ↓  -->
		<table style="width: 100%">
		<tr>
		<td><a href="index.html#1">
<img src="img/konntyu2_046_small.jpg" width="146" /></a></td><td><a href="index.html#2">
<img src="img/konntyu2_050_small.jpg" width="146" /></a></td><td><a href="index.html#3">
<img src="img/konntyu2_068_small.jpg" width="146" /></a></td><td><a href="index.html#4">
<img src="img/konntyu2_056_small.jpg" width="146" /></a></td><td><a href="index.html#5">
<img src="img/konntyu2_065_small.jpg" width="146" /></a></td>
		</tr>
		<tr>
		<td><a href="index.html#6">
<img src="img/konntyu2_075_small.jpg" width="146" /></a></td><td><a href="#7">
<img src="img/konntyu2_082_small.jpg" width="146" /></a></td><td><a href="#8">
<img src="img/konntyu2_042_small.jpg" width="146" /></a></td><td><a href="#9">
<img src="img/konntyu2_086_small.jpg" width="146" /></a></td><td><a href="#10">
<img src="img/konntyu2_089_small.jpg" width="146" /></a></td>
		</tr>
		<tr>
		<td><a href="#11">
<img src="img/konntyu2_095_small.jpg" width="146" /></a></td><td><a href="#12">
<img src="img/konntyu2_100_small.jpg" width="146" /></a></td><td>&nbsp;</td><td>&nbsp;</td><td>
			&nbsp;</td>
		</tr>
