		<td><a href="#11">
<img src="img/konntyu1_094_small.jpg" width="146" /></a></td><td><a href="#12">
<img src="img/konntyu1_098_small.jpg" width="146" /></a></td><td>&nbsp;</td><td>&nbsp;</td><td>
			&nbsp;</td>
