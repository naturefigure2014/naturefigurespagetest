			<tr><th id="16">&nbsp;</th></tr>
			<tr><td>&nbsp;</td></tr>
			<tr><td class="comment">&nbsp;</td></tr>
			-->
			<tr><td><a href="img/konntyu1_037.jpg">
				<img height="283" src="img/konntyu1_037_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/yujin/konntyu1/img/konntyu1_037.jpg" --></a></td></tr>
			</table>
		
