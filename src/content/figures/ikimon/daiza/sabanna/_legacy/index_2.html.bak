	<div id="collection_page">
		<div id="collection_page_head">
		<h4>奇譚クラブ ネイチャーテクニカラー　サバンナ ページ2<br />
			</h4>
			<p>
			「ネイチャーテクニカラー　サバンナ」のページ2です。<br />
			<a href="index.html">ページ1はコチラ</a>。<br />
			</p>
		</div>
		<div id="collection_page_main">
		
		<!-- ↓ラインナップ一覧サムネ↓  -->
		<table style="width: 100%">
		<tr>
		<td><a href="index.html#1">
<img src="img/sabanna040_small.jpg" width="146" /></a></td><td><a href="index.html#2">
<img src="img/sabanna047_small.jpg" width="146" /></a></td><td><a href="index.html#3">
<img src="img/sabanna048_small.jpg" width="146" /></a></td><td><a href="index.html#4">
<img src="img/sabanna052_small.jpg" width="146" /></a></td><td><a href="index.html#5">
