					<img height="283" src="../../../go_out/kitan10_nagoya/img/kitan10_nagoya032.jpg" width="378" /><img height="283" src="../../../go_out/kitan10_nagoya/img/kitan10_nagoya033.jpg" width="378" /></td></tr>
