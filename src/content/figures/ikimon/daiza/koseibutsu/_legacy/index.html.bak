<tr><td><a href="img/koseibutsu005.jpg"><img height="283" src="img/koseibutsu005_small.jpg" width="378" /></a><a href="img/koseibutsu006.jpg"><img height="283" src="img/koseibutsu006_small.jpg" width="378" /></a></td></tr>
