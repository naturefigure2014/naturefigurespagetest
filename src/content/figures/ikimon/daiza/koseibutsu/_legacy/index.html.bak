<tr><td><a href="img/koseibutsu009.jpg"><img height="283" src="img/koseibutsu009_small.jpg" width="378" /></a><a href="img/koseibutsu010.jpg"><img height="283" src="img/koseibutsu010_small.jpg" width="378" /></a></td></tr>
