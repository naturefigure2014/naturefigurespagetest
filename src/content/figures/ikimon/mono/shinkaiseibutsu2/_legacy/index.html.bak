					<a href="img/shinkai2_015.jpg">
					<img height="138" src="img/shinkai2_015_small.jpg" width="185" /><!-- Documents/My Web Sites/mysite2/ntc/mono/shinkaiseibutsu2/img/shinkai2_015.jpg" --></a></td><td>
					<a href="img/shinkai2_016.jpg">
					<img height="138" src="img/shinkai2_016_small.jpg" width="185" /><!-- Documents/My Web Sites/mysite2/ntc/mono/shinkaiseibutsu2/img/shinkai2_016.jpg" --></a></td>
