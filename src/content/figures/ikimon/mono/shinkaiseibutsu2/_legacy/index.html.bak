					ウロコフネタマガイ（シロスケ）</th>
				</tr>
				<tr>
					<td><a href="img/shinkai2_012.jpg">
					<img height="138" src="img/shinkai2_012_small.jpg" width="185" /><!-- Documents/My Web Sites/mysite2/ntc/mono/shinkaiseibutsu2/img/shinkai2_012.jpg" --></a></td><td>
					<a href="img/shinkai2_013.jpg">
					<img height="138" src="img/shinkai2_013_small.jpg" width="185" /><!-- Documents/My Web Sites/mysite2/ntc/mono/shinkaiseibutsu2/img/shinkai2_013.jpg" --></a></td><td>
					<a href="img/shinkai2_010.jpg">
					<img height="138" src="img/shinkai2_010_small.jpg" width="185" /><!-- Documents/My Web Sites/mysite2/ntc/mono/shinkaiseibutsu2/img/shinkai2_010.jpg" --></a></td><td>
					<a href="img/shinkai2_011.jpg">
					<img height="138" src="img/shinkai2_011_small.jpg" width="185" /><!-- Documents/My Web Sites/mysite2/ntc/mono/shinkaiseibutsu2/img/shinkai2_011.jpg" --></a></td>
