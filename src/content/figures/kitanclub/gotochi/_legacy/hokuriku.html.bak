<tr>
<td><a href="img/gotochi015_001.jpg">
<img height="283" src="img/gotochi015_001_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kitanclub/gotochi/img/gotochi015_001.jpg" --></a><a href="img/gotochi015_002.jpg"><img height="283" src="img/gotochi015_002_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kitanclub/gotochi/img/gotochi015_002.jpg" --></a></td>
