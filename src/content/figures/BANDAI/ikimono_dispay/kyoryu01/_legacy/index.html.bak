			<tr><th id="6">ディスプレイポップ</th></tr>
			<tr><td><a href="img/kyoryu01_023.jpg">
				<img height="283" src="img/kyoryu01_023_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/BANDAI/ikimono_dispay/kyoryu01/img/kyoryu01_023.jpg" --></a></td></tr>
