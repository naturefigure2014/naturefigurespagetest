<img height="283" src="img/dino6_011_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/dino/dinotales6/img/dino6_011.jpg" --></a><a href="img/dino6_012.jpg"><img height="283" src="img/dino6_012_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/dino/dinotales6/img/dino6_012.jpg" --></a><a href="img/dino6_009.jpg"><!-- Documents/My Web Sites/mysite2/dino/dinotales6/img/dino6_009.jpg" --></a><a href="img/dino6_010.jpg"><!-- Documents/My Web Sites/mysite2/dino/dinotales6/img/dino6_010.jpg" --></a></td>
