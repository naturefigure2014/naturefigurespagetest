<img height="283" src="img/dino6_053_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/dino/dinotales6/img/dino6_053.jpg" --></a><a href="img/dino6_052.jpg"><img height="283" src="img/dino6_052_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/dino/dinotales6/img/dino6_052.jpg" --></a><a href="img/dino6_051.jpg"><!-- Documents/My Web Sites/mysite2/dino/dinotales6/img/dino6_051.jpg" --></a><a href="img/dino6_050.jpg"><!-- Documents/My Web Sites/mysite2/dino/dinotales6/img/dino6_050.jpg" --></a></td>
