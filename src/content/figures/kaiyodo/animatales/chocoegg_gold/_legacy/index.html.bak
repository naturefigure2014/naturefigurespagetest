		<div id="collection_page_head">
		<h4>チョコエッグ　スペシャルゴールドバージョン</h4>
		<table style="width: 100%">
			<tr>
				<td>
				<a href="img/chocoegg_gold005.jpg">
				<img height="283" src="img/chocoegg_gold005_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/anima/chocoegg_gold/img/chocoegg_gold005.jpg" --></a></td>
