	<div id="collection_page">
		<div id="collection_page_head">
		<h4>チョコエッグ　日本の動物コレクション第3弾</h4>
		<table style="width: 100%">
		<tr><td><a href="img/anima_jap3_071.jpg">
			<img height="283" src="img/anima_jap3_071_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/anima/anima_jap3/img/anima_jap3_071.jpg" --></a><a href="img/anima_jap3_081.jpg"><img height="283" src="img/anima_jap3_081_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/anima/anima_jap3/img/anima_jap3_081.jpg" --></a></td></tr></table>
