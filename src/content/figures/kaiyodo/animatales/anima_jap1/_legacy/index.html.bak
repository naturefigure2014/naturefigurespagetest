	<div id="collection_page">
		<div id="collection_page_head">
		<h4>チョコエッグ　日本の動物コレクション第1弾</h4>
		<table width="100%">
			<tr>
				<td colspan="2">
				<a href="img/anima_jap1_033.jpg">
				<img height="283" src="img/anima_jap1_033_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/anima/anima_jap1/img/anima_jap1_033.jpg" --></a></td>
			</tr>
