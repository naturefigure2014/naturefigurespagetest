			-->
			<tr><th id="13">ディスプレイポップ</th></tr>
			<tr><td><a href="img/capqanima5dp1.jpg">
	<img height="453" src="img/capqanima5dp1_small.jpg" width="378" /></a><a href="img/capqanima5dp2.jpg"><img height="453" src="img/capqanima5dp2_small.jpg" width="378" /></a></td></tr>
			<tr><td class="comment">&nbsp;</td></tr>
			<!--
			-->			
			<tr><th id="14">解説書</th></tr>
			<tr><td><a href="img/capqanima5kaisetsu.jpg">
	<img height="368" src="img/capqanima5kaisetsu_small.jpg" width="756" /></a></td></tr>
