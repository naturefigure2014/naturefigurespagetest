	<div id="collection_page">
		<div id="collection_page_head">
		<h4>チョコエッグ　日本の動物コレクション第2弾</h4>
		<table style="width: 100%">
			<tr>
				<td colspan="2">
				<a href="img/anima_jap2_024.jpg">
				<img height="283" src="img/anima_jap2_024_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/anima/anima_jap2/img/anima_jap2_024.jpg" --></a><a href="img/anima_jap2_044.jpg"><img height="283" src="img/anima_jap2_044_small.jpg" width="378" /></a></td>
			</tr>
			<!--<tr>
				<td class="waku_left" valign="top" style="width: 50%">
				<span class="auto-style1">025.オコジョ</span><br class="auto-style1" />
