			<tr><td><a href="img/anima_japVI022.jpg">
<img height="283" src="img/anima_japVI022_small.jpg" width="378" /></a><a href="img/anima_japVI023.jpg"><img height="283" src="img/anima_japVI023_small.jpg" width="378" /></a></td></tr>
