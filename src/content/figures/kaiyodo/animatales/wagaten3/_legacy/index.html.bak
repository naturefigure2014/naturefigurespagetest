			-->			
			<tr><th id="4">R0004. アカウミガメ </th></tr>
			<tr><td><a href="img/wagatenn_3_013.jpg">
<img height="283" src="img/wagatenn_3_013_small.jpg" width="378" /></a><a href="img/wagatenn_3_014.jpg"><img height="283" src="img/wagatenn_3_014_small.jpg" width="378" /></a></td></tr>
