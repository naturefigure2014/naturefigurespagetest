			-->			
			<tr><th id="2">R0002. ヒメダカ</th></tr>
			<tr><td><a href="img/wagatenn_3_009.jpg">
<img height="283" src="img/wagatenn_3_009_small.jpg" width="378" /></a><a href="img/wagatenn_3_010.jpg"><img height="283" src="img/wagatenn_3_010_small.jpg" width="378" /></a></td></tr>
