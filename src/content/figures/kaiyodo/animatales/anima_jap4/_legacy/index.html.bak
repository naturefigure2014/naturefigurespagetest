	<div id="collection_page">
		<div id="collection_page_head">
		<h4>チョコエッグ　日本の動物コレクション第4弾</h4>
		<table width="100%">
			<tr>
				<td>
				<a href="img/anima_jap4_018.jpg">
				<img height="283" src="img/anima_jap4_018_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/anima/anima_jap4/img/anima_jap4_018.jpg" --></a></td>
			</tr>
			<!--<tr>
				<td class="waku_left" valign="top" style="width: 50%">
				097.ニホンイタチ<br  />
				098.トノサマバッタ<br  />
