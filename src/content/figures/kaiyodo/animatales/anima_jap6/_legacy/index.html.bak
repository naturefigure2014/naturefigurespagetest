	<div id="collection_page">
		<div id="collection_page_head">
		<h4>チョコQ アニマテイルズ　日本の動物6</h4>
		<table style="width: 100%">
			<tr>
				<td colspan="2">
				<a href="img/anima_jap6061.jpg">
				<img height="283" src="img/anima_jap6061_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/anima/anima_jap6/img/anima_jap6061.jpg" --></a></td>
			</tr>
