							<tr>
					<td>
					<a href="img/kuzira002.jpg">
					<img height="283" src="img/kuzira002_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/kaiyodo_Kit_Prepaint/SofubiToyBox/013Azatoukujira/img/kuzira002.jpg" --></a></td>
