			<tr><th id="7">解説書</th></tr>
			<tr><td><img height="540" src="img/wakeattebook1.jpg" width="378" /><img height="540" src="img/wakeattebook2.jpg" width="378" /></td></tr>
			<tr><td class="comment">両面カラー。</td></tr>
			<!--
					
