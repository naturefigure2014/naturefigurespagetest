<tr>
<td>
<a href="#6"><img src="img/magnet011_small.jpg" width="146" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///G:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/magnet_aquarium/img/magnet011.jpg" --></a></td><td>&nbsp;</td><td>
