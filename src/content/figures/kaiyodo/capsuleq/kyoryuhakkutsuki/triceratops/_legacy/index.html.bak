			-->
			<tr><th id="7">解説書</th></tr>
			<tr><td><a href="img/tryserabook1.jpg">
<img height="534" src="img/tryserabook1_small.jpg" width="378" /></a><a href="img/tryserabook2.jpg"><img height="532" src="img/tryserabook2_small.jpg" width="378" /></a></td></tr>
			<tr><td class="comment">&nbsp;</td></tr>
			<!--
			-->			
			<tr><th id="8">ラインナップ</th></tr>
			<tr><td class="comment">1. トリケラトプス復元<br />
				2. トリケラトプス全身骨格<br />
