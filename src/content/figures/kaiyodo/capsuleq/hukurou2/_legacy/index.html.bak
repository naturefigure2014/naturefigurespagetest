		<!-- ↑ラインナップ一覧サムネ↑  -->

		
			<table style="width: 100%">
			<!--
			-->
			<tr><th id="1">アナホリフクロウ（幼鳥）</th></tr>
			<tr><td><a href="img/hukurou2_012.jpg">
				<img height="283" src="img/hukurou2_012_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_012.jpg" --></a></td></tr>
			<tr><td class="comment">原型制作：山本聖士<br />
				<br />
				珍しく昼行性のフクロウ。<br />
				プレーリードッグの古巣に棲むため、アナホリの和名があるようです。<br />
				スラッと脚が長いのが特徴。</td></tr>
			<tr><td><a href="img/hukurou2_013.jpg"><img height="283" src="img/hukurou2_013_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_013.jpg" --></a><a href="img/hukurou2_014.jpg"><img height="283" src="img/hukurou2_014_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_014.jpg" --></a></td></tr>
			<tr><td class="comment">&nbsp;</td></tr>
			<tr><td class="comment">初版（右）と比較。</td></tr>
			<tr><td><a href="img/hukurou2_019.jpg">
				<img height="283" src="img/hukurou2_019_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_019.jpg" --></a><a href="img/hukurou2_020.jpg"><img height="283" src="img/hukurou2_020_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_020.jpg" --></a></td></tr>
			<tr><td><a href="img/hukurou2_021.jpg">
				<img height="283" src="img/hukurou2_021_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_021.jpg" --></a></td></tr>
			<tr><td class="comment">再販版では幼鳥の特徴である白い腹と、胸の境が直線的になっています。<br />
				脚の塗装も変わっていますね。</td></tr>
			<!--
			-->			
			<tr><th id="2">メンフクロウ（白化）</th></tr>
			<tr><td><a href="img/hukurou2_004.jpg">
				<img height="283" src="img/hukurou2_004_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_004.jpg" --></a></td></tr>
			<tr><td class="comment">原型制作：山本聖士<br />
				<br />
				白いメンフクロウは珍しく、白ければ白いほど高価になるそうです。</td></tr>
			<tr><td><a href="img/hukurou2_005.jpg"><img height="283" src="img/hukurou2_005_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_005.jpg" --></a><a href="img/hukurou2_006.jpg"><img height="283" src="img/hukurou2_006_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_006.jpg" --></a></td></tr>
			<tr><td class="comment">&nbsp;</td></tr>
			<tr><td class="comment">顔面以外は第一弾のカラバリとなっています。</td></tr>
			<tr><td><a href="img/hukurou2_023.jpg">
				<img height="283" src="img/hukurou2_023_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_023.jpg" --></a><a href="img/hukurou2_024.jpg"><img height="283" src="img/hukurou2_024_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_024.jpg" --></a></td></tr>
			<tr><td class="comment">&nbsp;</td></tr>
			<!--
			-->
			<tr><th id="3">メガネフクロウ</th></tr>
			<tr><td><a href="img/hukurou2_001.jpg">
				<img height="283" src="img/hukurou2_001_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_001.jpg" --></a></td></tr>
			<tr><td class="comment">原型制作：菅谷中<br />
				<br />
				白い羽角が目の上下にあり、メガネをかけているかのようなフクロウ。</td></tr>
			<tr><td><a href="img/hukurou2_002.jpg"><img height="283" src="img/hukurou2_002_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_002.jpg" --></a><a href="img/hukurou2_003.jpg"><img height="283" src="img/hukurou2_003_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_003.jpg" --></a></td></tr>
			<tr><td class="comment">&nbsp;</td></tr>
			<!--
			-->			
			<tr><th id="4">ウサギフクロウ</th></tr>
			<tr><td><a href="img/hukurou2_015.jpg">
				<img height="283" src="img/hukurou2_015_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_015.jpg" --></a><a href="img/hukurou2_016.jpg"><img height="283" src="img/hukurou2_016_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_016.jpg" --></a></td></tr>
			<tr><td class="comment">原型制作：菅谷中<br />
				<br />
				ウサギのように、大きな羽角を持ったフクロウ。<br />
				英名はStriped owl（タテジマフクロウ）。<br />
				<br />
				塗装見本にはある、眉間の黒が無いせいか、ちょっとさっぱりした印象があります。</td></tr>
			<tr><td class="comment">&nbsp;</td></tr>
			<tr><td><a href="img/hukurou2_017.jpg">
				<img height="283" src="img/hukurou2_017_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_017.jpg" --></a><a href="img/hukurou2_018.jpg"><img height="283" src="img/hukurou2_018_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_018.jpg" --></a></td></tr>
			<tr><td class="comment">&nbsp;</td></tr>
			<!--
			-->
			<tr><th id="5">フクロウ（ヒナ）</th></tr>
			<tr><td><a href="img/hukurou2_007.jpg">
				<img height="283" src="img/hukurou2_007_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_007.jpg" --></a><a href="img/hukurou2_008.jpg"><img height="283" src="img/hukurou2_008_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_008.jpg" --></a></td></tr>
			<tr><td class="comment">原型制作：松村しのぶ<br />
				<br />
				前作にはなかった変わり種枠として、フクロウ雛の2羽がラインナップ。<br />
もちろん、2羽とも顔が回ります。<br />
				<br />
				フクロウに絞ったラインナップだからこそできる、素晴らしいフィギュア。</td></tr>
			<tr><td><a href="img/hukurou2_009.jpg">
				<img height="283" src="img/hukurou2_009_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_009.jpg" --></a><a href="img/hukurou2_010.jpg"><img height="283" src="img/hukurou2_010_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_010.jpg" --></a></td></tr>
			<tr><td><a href="img/hukurou2_011.jpg">
				<img height="283" src="img/hukurou2_011_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/CapQ/hukurou2/img/hukurou2_011.jpg" --></a></td></tr>
