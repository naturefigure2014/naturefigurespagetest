			<a href="../ouritsu_EX/index.html">
<img src="../ouritsu2_White/img/SpaceShuttle001_small.jpg" width="146" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///D:/My Web Sites/mysite2/ex1_space/ouritsu2_White/img/SpaceShuttle001.jpg" --></a></td><td>&nbsp;</td>
