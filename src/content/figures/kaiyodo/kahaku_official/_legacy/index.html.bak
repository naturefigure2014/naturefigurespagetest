										<tr>
					<th id="1">001.アサヒガニ</th>				</tr>
				<tr>
					<td >
					<a href="img/kahaku007.jpg">
					<img height="283" src="img/kahaku007_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/kaiyodo_Kit_Prepaint/kahaku_official/img/kahaku007.jpg" --></a><a href="img/kahaku008.jpg"><img height="283" src="img/kahaku008_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/kaiyodo_Kit_Prepaint/kahaku_official/img/kahaku008.jpg" --></a></td>
				</tr>
				<tr>
					<td >
