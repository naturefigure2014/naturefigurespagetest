							<tr>
					<th id="7">007.アルシノイテリウム(頭部骨格)</th>				</tr>
				<tr>
					<td >
					<a href="img/kahaku013.jpg">
					<img height="283" src="img/kahaku013_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/kaiyodo_Kit_Prepaint/kahaku_official/img/kahaku013.jpg" --></a><a href="img/kahaku014.jpg"><img height="283" src="img/kahaku014_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/kaiyodo_Kit_Prepaint/kahaku_official/img/kahaku014.jpg" --></a></td>
