		<div id="collection_page_head">
			<h3>バードテイルズ2 森と清流 BIRDTALES-2 </h3>
		<table width="100%">
			<tr>
				<td rowspan="2" valign="top" style="width: 215px">
				<a href="img/birdtales2_020.jpg">
				<!-- Documents/My Web Sites/mysite2/kaiyodo_syokugann/birdtales2/img/birdtales2_020.jpg" --></a>
