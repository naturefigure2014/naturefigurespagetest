	<div id="collection_page">
				<div id="collection_page_head">
		<h4>海洋堂　DINOLAND　マメモデル / ごま恐竜</h4>
		<table width="100%">
		<tr><td>
				<a href="img/mamemodel010.jpg">
				<img height="283" src="img/mamemodel010_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/kaiyodo_Kit_Prepaint/dinoland/mamemodel/img/mamemodel010.jpg" --></a></td><td>
