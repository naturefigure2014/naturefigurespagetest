					<img height="283" src="img/allo002_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/kaiyodo_Kit_Prepaint/dinoland/skull_mini_model/img/allo002.jpg" --></a><a href="img/allo001.jpg"><img height="283" src="img/allo001_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/kaiyodo_Kit_Prepaint/dinoland/skull_mini_model/img/allo001.jpg" --></a></td>
				</tr>
