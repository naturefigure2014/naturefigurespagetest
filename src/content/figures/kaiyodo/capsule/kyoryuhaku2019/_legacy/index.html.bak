<tr><td><a href="img/mosa_cap.jpg">
	<img height="283" src="img/mosa_cap_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///G:/My Web Sites/mysite2/kaiyodo_Capsule/kyoryuhaku2019/img/mosa_cap.jpg" --></a><img height="139" src="img/mosa_book.jpg" width="378" /></td></tr>
