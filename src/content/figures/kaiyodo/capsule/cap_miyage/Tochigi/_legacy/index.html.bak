			<tr><td><a href="img/tochigiDP.jpg">
				<img height="283" src="img/tochigiDP_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///G:/My Web Sites/mysite2/kaiyodo_Capsule/cap_miyage/Tochigi/img/tochigiDP.jpg" --></a></td></tr>
