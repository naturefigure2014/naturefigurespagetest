			<tr><th id="9">ディスプレイポップ</th></tr>
			<tr><td><a href="img/tokyoDP.jpg">
				<img height="283" src="img/tokyoDP_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///G:/My Web Sites/mysite2/kaiyodo_Capsule/cap_miyage/Tokyo/img/tokyoDP.jpg" --></a><img height="283" src="img/tokyoDP2.jpg" width="378" /></td></tr>
