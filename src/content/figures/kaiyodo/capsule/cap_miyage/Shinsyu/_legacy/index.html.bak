			<tr><th id="10">ディスプレイポップ</th></tr>
			<tr><td><a href="img/shinsyuDP.jpg">
				<img height="283" src="img/shinsyuDP_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///G:/My Web Sites/mysite2/kaiyodo_Capsule/cap_miyage/Shinsyu/img/shinsyuDP.jpg" --></a></td></tr>
