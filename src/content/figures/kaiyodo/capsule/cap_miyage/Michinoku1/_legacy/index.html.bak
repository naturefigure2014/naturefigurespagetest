			-->
			<tr><th id="3">シークレット：南部鉄器（カラー）</th></tr>
			<tr><td>
				<a href="img/michinoku1_042.jpg">
				<img height="283" src="img/michinoku1_042_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///G:/My Web Sites/mysite2/kaiyodo_Capsule/cap_miyage/Michinoku1/img/michinoku1_042.jpg" --></a><a href="img/michinoku1_043.jpg"><img height="283" src="img/michinoku1_043_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///G:/My Web Sites/mysite2/kaiyodo_Capsule/cap_miyage/Michinoku1/img/michinoku1_043.jpg" --></a></td></tr>
			<tr><td>
