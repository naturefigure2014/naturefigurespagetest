			<table style="width: 100%">
			<!--
			-->
			<tr><th id="1">1.黄金の顔</th></tr>
			<tr><td><a href="img/TaroQhikari003.jpg">
				<img height="283" src="img/TaroQhikari003_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari003.jpg" --></a><a href="img/TaroQhikari004.jpg"><img height="283" src="img/TaroQhikari004_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari004.jpg" --></a></td></tr>
			<tr><td><a href="img/TaroQhikari005.jpg">
				<img height="283" src="img/TaroQhikari005_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari005.jpg" --></a></td></tr>
			<tr><td class="comment">原型制作：市原俊成<br />
				<br />
				太陽の塔上部の顔。<br />
				避雷針も細かく再現されています。<br />
				両目が光るギミック付き。</td></tr>
			<!--
			-->			
			<tr><th id="2">2.光る彫刻</th></tr>
			<tr><td><a href="img/TaroQhikari001.jpg">
				<img height="283" src="img/TaroQhikari001_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari001.jpg" --></a><a href="img/TaroQhikari002.jpg"><img height="283" src="img/TaroQhikari002_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari002.jpg" --></a></td></tr>
			<tr><td class="comment">原型制作：松本栄一郎<br />
				<br />
				山形県寒河江市庁舎に飾られている照明作品。<br />
				本体が光るギミック付き。</td></tr>
			<!--
			-->
			<tr><th id="3">3. 光る時計（白）</th></tr>
			<tr><td><a href="img/TaroQhikari016.jpg">
				<img height="283" src="img/TaroQhikari016_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari016.jpg" --></a><a href="img/TaroQhikari017.jpg"><img height="283" src="img/TaroQhikari017_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari017.jpg" --></a></td></tr>
			<tr><td class="comment">原型制作：市原俊成<br />
				<br />
				壁掛け時計をミニチュア化。<br />
				2か所が発光するほか、長針と短針が可動します。</td></tr>
			<!--
			-->			
			<tr><th id="4">4. 光る時計（黒）</th></tr>
			<tr><td>&nbsp;</td></tr>
			<tr><td class="comment">原型制作：市原俊成</td></tr>
			<!--
			-->
			<tr><th id="5">5. 火の接吻</th></tr>
			<tr><td><a href="img/TaroQhikari014.jpg">
				<img height="283" src="img/TaroQhikari014_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari014.jpg" --></a><a href="img/TaroQhikari015.jpg"><img height="283" src="img/TaroQhikari015_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari015.jpg" --></a></td></tr>
			<tr><td class="comment">原型制作：村田明玄<br />
				<br />
				卓上ライターとしてデザインされたもの。<br />
				本来炎が出る口元を、LEDによる発光ギミックで再現。</td></tr>
			<!--
			-->			
			<tr><th id="6">6.犬の植木鉢</th></tr>
			<tr><td><a href="../masterpiece/img/TaroMP007.jpg">
				<img height="283" src="../masterpiece/img/TaroMP007_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/masterpiece/img/TaroMP007.jpg" --><a href="../masterpiece/img/TaroMP008.jpg"><img height="283" src="../masterpiece/img/TaroMP008_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/masterpiece/img/TaroMP008.jpg" --></a></a></td></tr>
			<tr><td class="comment">原型制作：香川雅彦<br />
				<br />
				犬型の鉢植え。<br />
				背中に植木を置くことができ、植木も１つ付属。</td></tr>
			<!--
			-->
			<tr><th id="7">7. ティーセット 夢の鳥／青</th></tr>
			<tr><td><a href="img/TaroQhikari021.jpg">
				<img height="283" src="img/TaroQhikari021_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari021.jpg" --></a><a href="img/TaroQhikari022.jpg"><img height="283" src="img/TaroQhikari022_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari022.jpg" --></a></td></tr>
			<tr><td class="comment">原型制作：寺岡邦明<br />
				<br />
				1977年に発売された陶磁器製のティーポットセット。</td></tr>
			<!--
			-->
			<tr><th id="8">8. ティーセット 夢の鳥／緑</th></tr>
			<tr><td><a href="img/TaroQhikari018.jpg">
				<img height="283" src="img/TaroQhikari018_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari018.jpg" --></a><a href="img/TaroQhikari019.jpg"><img height="283" src="img/TaroQhikari019_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari019.jpg" --></a></td></tr>
			<tr><td class="comment">原型制作：寺岡邦明<br />
				</td></tr>
			<!--
			-->			
			<tr><th id="9">9.パイラ人</th></tr>
			<tr><td><a href="img/TaroQhikari012.jpg">
				<img height="283" src="img/TaroQhikari012_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari012.jpg" --></a><a href="img/TaroQhikari013.jpg"><img height="283" src="img/TaroQhikari013_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari013.jpg" --></a></td></tr>
			<tr><td class="comment">原型制作：村田明玄<br />
				<br />
				岡本太郎がデザインした宇宙人。<br />
				1956年に公開された映画「宇宙人東京に現る」に登場。</td></tr>
			<!--
			-->			
			<tr><th id="10">10. 岡本太郎と太陽の塔</th></tr>
			<tr><td><a href="img/TaroQhikari006.jpg">
				<img height="283" src="img/TaroQhikari006_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari006.jpg" --></a><a href="img/TaroQhikari007.jpg"><img height="283" src="img/TaroQhikari007_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari007.jpg" --></a></td></tr>
			<tr><td><a href="img/TaroQhikari008.jpg">
				<img height="283" src="img/TaroQhikari008_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari008.jpg" --></a><a href="img/TaroQhikari009.jpg"><img height="283" src="img/TaroQhikari009_small.jpg" width="378" /><!-- MSComment="autothumbnail" xthumbnail-orig-image="file:///C:/My Web Sites/mysite2/kaiyodo_Capsule/OkamotoTaro/artpiece_hikarinokyoen/img/TaroQhikari009.jpg" --></a></td></tr>
			<tr><td class="comment">原型制作：太陽の塔・寺岡邦明、岡本太郎・東田万偶斎<br />
				<br />
				作品だけでなく、岡本太郎本人もテレビやCMで活躍しました。<br />
				そんな太朗と、代表作太陽の塔をデフォルメしてフィギュア化。</td></tr>
