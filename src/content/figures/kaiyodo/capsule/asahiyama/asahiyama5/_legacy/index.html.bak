<img src="img/asahiyama5_019_small.jpg" width="146" /></a></td><td><a href="#2">
<img src="img/asahiyama5_025_small.jpg" width="146" /></a></td><td><a href="#3">
<img src="img/asahiyama5_032_small.jpg" width="146" /></a></td><td><a href="#4">
<img src="img/asahiyama5_040_small.jpg" width="146" /></a></td><td><a href="#5">
<img src="img/asahiyama5_047_small.jpg" width="146" /></a></td>
		</tr>
		<tr>
		<td><a href="#6">
<img src="img/asahiyama5_052_small.jpg" width="146" /></a></td><td>&nbsp;</td><td>&nbsp;</td><td>
