		<h4>日本水族館立体生物図録</h4>
		<table style="width: 100%">
			<tr>
				<td colspan="2">
				<a href="img/zuroku1030.jpg">
				<!-- Documents/My Web Sites/mysite2/aqua/zuroku/zuroku1/img/zuroku1030.jpg" --></a>
