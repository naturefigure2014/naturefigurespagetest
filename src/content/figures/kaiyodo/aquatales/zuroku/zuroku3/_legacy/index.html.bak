	<div id="collection_page">
		<div id="collection_page_head">
		<h4>日本水族館立体生物図録3</h4>
				<table width="100%">
			<tr>
				<td>
				<a href="img/zuroku3_002.jpg">
				<!-- Documents/My Web Sites/mysite2/aqua/zuroku/zuroku3/img/zuroku3_002.jpg" --></a>
