	<div id="collection_page">
		<div id="collection_page_head">
		<h4>日本水族館立体生物図録6</h4>
		<table width="100%">
			<tr>
				<td>
				<a href="img/zuroku6_001.jpg">
				<!-- Documents/My Web Sites/mysite2/aqua/zuroku/zuroku6/img/zuroku6_001.jpg" --></a>
