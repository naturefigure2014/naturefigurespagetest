	<div id="collection_page">
		<div id="collection_page_head">
		<h4>日本水族館立体生物図録 第2巻</h4>
		<table width="100%">
			<tr>
				<td>
				<a href="img/zuroku2_008.jpg">
				<!-- Documents/My Web Sites/mysite2/aqua/zuroku/zuroku2/img/zuroku2_008.jpg" --></a>
				<img height="249" src="img/zuroku2_43.jpg" width="760" /></td>
			</tr>
