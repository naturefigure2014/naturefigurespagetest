	<div id="collection_page">
		<div id="collection_page_head">
		<h4>日本水族館立体生物図録4</h4>
						<table width="100%">
			<tr>
				<td>
				<a href="img/zuroku4_029.jpg">
				<!-- Documents/My Web Sites/mysite2/aqua/zuroku/zuroku4/img/zuroku4_029.jpg" --></a>
