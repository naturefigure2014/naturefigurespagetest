	<div id="collection_page">
		<div id="collection_page_head">
		<h4>MIU深海生物フィギュアコレクション　The Deep Sea Odyssey 1</h4>
		<table style="width: 100%">
			<tr>
				<td >
				<a href="img/miu_1_025.jpg">
				<!-- Documents/My Web Sites/mysite2/aqua/miu1/img/miu_1_025.jpg" --></a>
				<img height="225" src="img/miu_1_040.jpg" width="760" /></td>
			</tr>
