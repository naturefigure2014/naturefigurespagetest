	<div id="collection_page">
		<div id="collection_page_head">
		<h4>MIU深海生物フィギュアコレクション　The Deep Sea Odyssey 2</h4>
		<table style="width: 100%">
			<tr>
				<td >
				<a href="img/miu_2_053.jpg">
				<img height="283" src="img/miu_2_053_small.jpg" width="378" /><!-- Documents/My Web Sites/mysite2/aqua/miu2/img/miu_2_053.jpg" --></a></td>
			</tr>
