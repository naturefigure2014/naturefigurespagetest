<tr><td>
					<a href="../img/hakone006.jpg">
					<img height="283" src="../img/hakone006_small.jpg" width="378" /></a></td></tr>
<tr><td class="comment">&nbsp;</td></tr>
<tr><td class="comment">パッケージ。</td></tr>
<tr><td>
					<a href="../img/hakone011.jpg">
