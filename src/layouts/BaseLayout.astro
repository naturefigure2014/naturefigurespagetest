---
import { siteUrl } from "../lib/site-url";

const {
  title = "NATURE FIGURE | ネイチャーフィギュアのページ",
  description = "ネイチャーフィギュアのページ"
} = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href={siteUrl("/")}>
        <span class="logo-mark" aria-hidden="true">◒</span>
        <span class="logo-text">NATURE FIGURE</span>
      </a>
      <nav aria-label="メインナビゲーション">
        <a href={siteUrl("/species/")}>生きものから探す</a>
        <a href={siteUrl("/makers/")}>メーカーから探す</a>
        <a href={siteUrl("/titles/")}>タイトルから探す</a>
        <a href={siteUrl("/works/")}>塗装・改造</a>
        <a href={siteUrl("/figures/")}>フィギュア一覧</a>
        <a href={siteUrl("/blog/")}>ブログ</a>
      </nav>
      <div class="header-tools" aria-hidden="true"><span>⌕</span><span>◌</span></div>
    </header>
    <main>
      <slot />
    </main>
    <footer>Copyright (C) 2014 ネイチャーフィギュアのページ All rights reserved.</footer>
  </body>
</html>
