---
import { siteUrl } from "../lib/site-url";

const {
  title = "NATURE FIGURE | ネイチャーフィギュアのページ",
  description = "ネイチャーフィギュアのページ"
} = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href={siteUrl("/")}>
        <span class="logo-mark" aria-hidden="true">◒</span>
        <span class="logo-copy">
          <span class="logo-text">NATURE FIGURE</span>
          <span class="logo-subtitle">ネイチャーフィギュアのページ</span>
        </span>
      </a>
      <nav aria-label="メインナビゲーション">
        <a data-nav-section="/species" href={siteUrl("/species/")}>生きものから探す</a>
        <a data-nav-section="/themes" href={siteUrl("/themes/")}>テーマから探す</a>
        <a data-nav-section="/makers" href={siteUrl("/makers/")}>メーカー・タイトルから探す</a>
        <a data-nav-section="/works" href={siteUrl("/works/")}>塗装・改造</a>
        <a data-nav-section="/figures" href={siteUrl("/figures/")}>フィギュア一覧</a>
        <a data-nav-section="/blog" href={siteUrl("/blog/")}>ブログ</a>
      </nav>
      <div class="header-tools" aria-hidden="true"><span>⌕</span><span>◌</span></div>
    </header>
    <main>
      <slot />
    </main>
    <footer><span>Copyright (C) 2014 ネイチャーフィギュアのページ All rights reserved.</span></footer>
  </body>
</html>

<script>
  const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
  const pathname = window.location.pathname;
  const currentPath = pathname === basePath || pathname.startsWith(`${basePath}/`)
    ? pathname.slice(basePath.length) || "/"
    : pathname;
  document.querySelectorAll<HTMLAnchorElement>("[data-nav-section]").forEach((link) => {
    const section = link.dataset.navSection ?? "";
    if (currentPath === section || currentPath.startsWith(`${section}/`)) {
      link.classList.add("is-active");
    }
  });
</script>
