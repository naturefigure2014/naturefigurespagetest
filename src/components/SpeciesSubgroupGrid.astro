---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { resolveFigureImage } from "../lib/figure-images";
import { getSpeciesEntries } from "../lib/species";
import { siteUrl } from "../lib/site-url";

interface Subgroup {
  id?: string;
  name: string;
  species?: string[];
  speciesGroups?: string[];
  icon: string;
}

interface Props {
  title: string;
  icon: string;
  groups: Subgroup[];
}

const { title, icon, groups } = Astro.props;
const figures = (await getCollection("figures")).filter(
  (item) => item.data.contentType !== "title" && getSpeciesEntries(item.data).length > 0
);

const figuresForGroup = (group: Subgroup) =>
  figures.filter((figure) => {
    return getSpeciesEntries(figure.data).some((entry) =>
      (group.species ?? []).includes(entry.species) ||
      (group.speciesGroups ?? []).some(
        (prefix) => entry.speciesGroup === prefix || entry.speciesGroup.startsWith(`${prefix}/`)
      )
    );
  });

const groupImage = (group: Subgroup) => {
  const figure = figuresForGroup(group)[0];
  return figure
    ? resolveFigureImage(
        figure.id,
        figure.data.coverImage ?? figure.data.topics.flatMap((topic) => topic.images)[0]
      )
    : undefined;
};

const groupCount = (group: Subgroup) =>
  new Set(figuresForGroup(group).flatMap((figure) => getSpeciesEntries(figure.data).map((entry) => entry.species))).size;
---

<BaseLayout title={`${title} | NATURE FIGURE`}>
  <div class="mammals-page">
    <div class="breadcrumb">
      <a href={siteUrl("/")}>ホーム</a><span>›</span>
      <a href={siteUrl("/species/")}>生きものから探す</a><span>›</span>
      {title}
    </div>
    <section class="mammals-hero">
      <div class="mammals-hero-copy">
        <p class="eyebrow">生きものから探す</p>
        <h1>{title}</h1>
      </div>
      <div class="mammals-hero-art" aria-hidden="true">{icon}</div>
    </section>
    <div class="mammal-group-grid">
      {groups.map((group) => {
        const image = groupImage(group);
        return (
          <a class="mammal-group-card" href={siteUrl(group.id ? `/species/${group.id}/` : "/figures/")}>
            <div class="mammal-group-media">
              {image ? <img src={image} alt="" loading="lazy" /> : <span>{group.icon}</span>}
            </div>
            <div class="mammal-group-footer">
              <span class="mammal-group-icon" aria-hidden="true">{group.icon}</span>
              <div>
                <strong>{group.name}</strong>
                <small>{groupCount(group)}種類</small>
              </div>
              <span class="mammal-group-arrow" aria-hidden="true">›</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
