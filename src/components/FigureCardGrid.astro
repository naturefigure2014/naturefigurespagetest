---
import MakerCardBadges from "./MakerCardBadges.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { resolveFigureImage } from "../lib/figure-images";
import { makerBadgeClass, makerNames } from "../lib/maker";
import { siteUrl } from "../lib/site-url";

type Figure = CollectionEntry<"figures">;
interface Props {
  figures: Figure[];
}

const { figures } = Astro.props;
const allEntries = await getCollection("figures");
const allFigures = allEntries.filter((item) => item.data.contentType !== "title");

const normalizeId = (id: string) => id.replace(/\/index(?:\.md)?$/, "");
const figureHref = (figure: Figure) => siteUrl(`/figures/${normalizeId(figure.id)}/`);
const titleForFigure = (figure: Figure) =>
  allEntries.find(
    (entry) =>
      entry.data.contentType === "title" &&
      (
        normalizeId(entry.id) === normalizeId(figure.data.titleId ?? "") ||
        entry.data.figureIds.some((figureId) => normalizeId(figureId) === normalizeId(figure.id))
      )
  );
const imageForFigure = (figure: Figure) =>
  [figure.data.coverImage, ...figure.data.topics.flatMap((topic) => topic.images)]
    .map((ref) => resolveFigureImage(figure.id, ref))
    .find((image) => image !== undefined);
const imageFor = (figure: Figure) => {
  const figureImage = imageForFigure(figure);
  if (figureImage) return figureImage;

  const title = titleForFigure(figure);
  if (!title) return undefined;

  const titleImage = [title.data.collectionImage, title.data.coverImage]
    .map((ref) => resolveFigureImage(title.id, ref))
    .find((image) => image !== undefined);
  if (titleImage) return titleImage;

  return title.data.figureIds
    .map((figureId) => allFigures.find((item) => normalizeId(item.id) === normalizeId(figureId)))
    .filter((item): item is Figure => item !== undefined)
    .map(imageForFigure)
    .find((image) => image !== undefined);
};
const figureMetadata = (figure: Figure) => {
  const title = titleForFigure(figure);
  const ownSeriesName = Array.isArray(figure.data.seriesName)
    ? figure.data.seriesName.join("・")
    : figure.data.seriesName;
  const titleName = title ? title.data.shortTitle || title.data.title : ownSeriesName || "-";
  const makers = makerNames(title?.data.maker ?? figure.data.maker);
  const releaseYear =
    (figure.data.releaseDate instanceof Date
      ? figure.data.releaseDate.getFullYear().toString()
      : undefined) ??
    title?.data.releaseStart?.match(/^\d{4}/)?.[0] ??
    figure.data.releaseStart?.match(/^\d{4}/)?.[0] ??
    title?.data.salesPeriod?.match(/^\d{4}/)?.[0] ??
    figure.data.salesPeriod?.match(/^\d{4}/)?.[0] ??
    "-";

  return {
    titleName,
    sculptor: figure.data.sculptor || "-",
    maker: makers.length > 0 ? makers.join("・") : "-",
    makerClass: makerBadgeClass(makers[0] ?? ""),
    releaseYear
  };
};
---

<div class="species-detail-grid">
  {figures.map((figure) => {
    const metadata = figureMetadata(figure);

    return (
      <a class="species-detail-card" href={figureHref(figure)}>
        <span class="species-detail-media">
          <img src={imageFor(figure)} alt="" loading="lazy" />
          <MakerCardBadges collectionStatus={figure.data.collectionStatus ?? titleForFigure(figure)?.data.collectionStatus} />
        </span>
        <div>
          <strong>{figure.data.title}</strong>
          <small>{metadata.titleName}</small>
          <small class="species-detail-sculptor">{metadata.sculptor}</small>
          <div class="species-detail-meta">
            <span class:list={["species-detail-maker", metadata.makerClass]}>{metadata.maker}</span>
            <small class="species-detail-year">{metadata.releaseYear}</small>
          </div>
          <b aria-hidden="true">›</b>
        </div>
      </a>
    );
  })}
</div>
