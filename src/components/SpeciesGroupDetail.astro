---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { resolveFigureImage } from "../lib/figure-images";
import { getSpeciesEntries } from "../lib/species";
import { siteUrl } from "../lib/site-url";

interface Props {
  title: string;
  groups: string[];
  species?: string[];
  icon: string;
  description: string;
}

const { title, groups, species = [], icon, description } = Astro.props;
const groupPrefixes = groups;
const belongsToGroup = (speciesGroup: string) =>
  groupPrefixes.some((prefix) =>
    speciesGroup === prefix ||
    speciesGroup.startsWith(`${prefix}/`) ||
    speciesGroup.endsWith(`/${prefix}`)
  );
const belongsToPage = (entry: { species: string; speciesGroup: string }) =>
  species.includes(entry.species) || belongsToGroup(entry.speciesGroup);
const figures = (await getCollection("figures")).filter(
  (item) =>
    item.data.contentType !== "title" &&
    getSpeciesEntries(item.data).some(belongsToPage)
);
const imageFor = (figure: (typeof figures)[number]) =>
  [
    figure.data.coverImage,
    ...figure.data.topics.flatMap((topic) => topic.images)
  ]
    .map((image) => resolveFigureImage(figure.id, image))
    .find((resolvedImage) => resolvedImage !== undefined);
const speciesHref = (species: string) => siteUrl(`/species/species/${encodeURIComponent(species)}/`);
type SpeciesCardEntry = { figure: (typeof figures)[number]; species: string };
const speciesCards = new Map<string, SpeciesCardEntry>();
for (const figure of figures) {
  for (const entry of getSpeciesEntries(figure.data)) {
    if (belongsToPage(entry)) {
      speciesCards.set(entry.species, { figure, species: entry.species });
    }
  }
}
const speciesEntries = Array.from(speciesCards.values());
const sortedSpeciesEntries = [...speciesEntries].sort((a, b) =>
  a.species.localeCompare(b.species, "ja")
);
const countForSpecies = (species: string) =>
  figures.filter((figure) =>
    getSpeciesEntries(figure.data).some(
      (entry) => entry.species === species && belongsToPage(entry)
    )
  ).length;
const featured = speciesEntries.slice(0, 3);

---

<BaseLayout title={`${title} | NATURE FIGURE`}>
  <div class="primates-page">
    <div class="breadcrumb">
      <a href={siteUrl("/")}>ホーム</a><span>›</span>
      <a href={siteUrl("/species/")}>生きものから探す</a><span>›</span>
      {title}
    </div>

    <section class="primates-hero">
      <div class="primates-hero-copy">
        <h1>{title}</h1>
        <p>{description}</p>
      </div>
      <div class="primates-hero-art" aria-hidden="true">{icon}</div>
    </section>

    <section class="primates-section">
      <h2>★ 注目の種</h2>
      <div class="primates-featured">
        {featured.length > 0 ? featured.map((entry) => (
          <a class="primate-feature-card" href={speciesHref(entry.species)}>
            <img src={imageFor(entry.figure)} alt="" loading="lazy" />
            <div class="primate-feature-body">
              <strong>{entry.species}</strong>
              <small>♟ フィギュア {countForSpecies(entry.species)}種</small>
              <span aria-hidden="true">›</span>
            </div>
          </a>
        )) : <p class="primates-empty">現在、登録されている{title}のフィギュアはありません。</p>}
      </div>
    </section>

    <section class="primates-section primates-list-section">
      <h2>☷ {title}の種一覧</h2>
      <div class="primate-list">
        {sortedSpeciesEntries.map((entry) => (
          <a class="primate-list-item" href={speciesHref(entry.species)}>
            <img src={imageFor(entry.figure)} alt="" loading="lazy" />
            <span>
              <strong>{entry.species}</strong>
              <small>フィギュア {countForSpecies(entry.species)}種</small>
            </span>
            <span class="primate-list-arrow" aria-hidden="true">›</span>
          </a>
        ))}
      </div>
      {figures.length === 0 && <p class="primates-empty">現在、登録されている{title}のフィギュアはありません。</p>}
    </section>
  </div>
</BaseLayout>
