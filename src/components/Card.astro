---
const { href, label, title, description, image } = Astro.props;
---
<a class="card" href={href}>
  {image ? <img class="card-image" src={image} alt="" loading="lazy" /> : <div class="thumb">{label}</div>}
  <div class="body">
    <div class="eyebrow">{label}</div>
    <h3>{title}</h3>
    {description && <p>{description}</p>}
  </div>
</a>
