---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { resolveFigureImage } from "../../lib/figure-images";
import { siteUrl } from "../../lib/site-url";

export async function getStaticPaths() {
  const allEntries = await getCollection("figures");
  const allFigures = allEntries.filter(
    (item) => item.data.contentType !== "title" && item.data.species && item.data.speciesGroup === "霊長類"
  );
  const speciesNames = [...new Set(allFigures.map((figure) => figure.data.species).filter(Boolean))];
  return speciesNames.map((species) => ({ params: { species } }));
}

const allEntries = await getCollection("figures");
const allFigures = allEntries.filter(
  (item) => item.data.contentType !== "title" && item.data.species && item.data.speciesGroup === "霊長類"
);
const speciesName = Astro.params.species ?? "";
const figures = allFigures.filter((figure) => figure.data.species === speciesName);
const imageFor = (figure: (typeof allFigures)[number]) =>
  resolveFigureImage(
    figure.id,
    figure.data.coverImage ?? figure.data.topics.flatMap((topic) => topic.images)[0]
  );
const figureHref = (figure: (typeof allFigures)[number]) =>
  siteUrl(`/figures/${figure.id.replace(/\/index(?:\.md)?$/, "")}/`);
const normalizeId = (id: string) => id.replace(/\/index(?:\.md)?$/, "");
const titleForFigure = (figure: (typeof allFigures)[number]) =>
  allEntries.find(
    (entry) =>
      entry.data.contentType === "title" &&
      normalizeId(entry.id) === normalizeId(figure.data.titleId ?? "")
  );
const makerBadgeClass = (maker?: string) => {
  switch (maker) {
    case "海洋堂": return "maker-kaiyodo";
    case "バンダイ": return "maker-bandai";
    case "タカラトミー": return "maker-takaratomy";
    case "リーメント": return "maker-re-ment";
    case "奇譚クラブ": return "maker-kitan-club";
    default: return "maker-default";
  }
};
const titleFor = figures[0]?.data.scientificName
  ? `${speciesName} (${figures[0].data.scientificName})`
  : speciesName;
---

<BaseLayout title={`${speciesName} | NATURE FIGURE`}>
  <div class="species-detail-page">
    <div class="breadcrumb">
      <a href={siteUrl("/")}>ホーム</a><span>›</span>
      <a href={siteUrl("/species/")}>生きものから探す</a><span>›</span>
      <a href={siteUrl("/species/primates/")}>霊長類</a><span>›</span>
      {speciesName}
    </div>

    <section class="species-detail-hero">
      <p class="eyebrow">霊長類</p>
      <h1>{speciesName}</h1>
      {figures[0]?.data.scientificName && <p>{figures[0].data.scientificName}</p>}
    </section>

    <section class="species-detail-section">
      <h2>{titleFor}のフィギュア</h2>
      <p class="species-detail-count">{figures.length}種類のフィギュア</p>
      <div class="species-detail-grid">
        {figures.map((figure) => (
          <a class="species-detail-card" href={figureHref(figure)}>
            <img src={imageFor(figure)} alt="" loading="lazy" />
            <div>
              <strong>{figure.data.title}</strong>
              {titleForFigure(figure) && <small>{titleForFigure(figure)?.data.title}</small>}
              <span class:list={["species-detail-maker", makerBadgeClass(titleForFigure(figure)?.data.maker ?? figure.data.maker)]}>
                {titleForFigure(figure)?.data.maker ?? figure.data.maker ?? "メーカー"}
              </span>
              <b aria-hidden="true">›</b>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
