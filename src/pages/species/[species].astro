}*/

const allEntries = await getCollection("figures");
const allFigures = allEntries.filter(
  (item) => item.data.contentType !== "title" && getSpeciesEntries(item.data).length > 0
);
const speciesName = Astro.params.species ?? "";
const figures = allFigures.filter((figure) =>
  getSpeciesEntries(figure.data).some((entry) => entry.species === speciesName)
);
const speciesGroups = Array.from(new Set(figures.flatMap((figure) =>
  getSpeciesEntries(figure.data)
    .filter((entry) => entry.species === speciesName)
    .map((entry) => entry.speciesGroup)
)));
const speciesGroup = speciesGroups.join("・") || "分類未設定";
const speciesGroupBreadcrumb = speciesGroups
  .map((group) => group.split("/").filter(Boolean).join(" › "))
  .join("・");

export async function getStaticPaths() {
  const allEntries = await getCollection("figures");
  const speciesNames = [
    ...new Set(
      allEntries
        .filter((item) => item.data.contentType !== "title")
        .flatMap((item) => getSpeciesEntries(item.data)
          .filter((entry) => entry.speciesGroup !== UNCLASSIFIED_GROUP)
          .map((entry) => entry.species))
    )
  ];

  return speciesNames.map((species) => ({ params: { species } }));
}
---

<BaseLayout title={`${speciesName} | NATURE FIGURE`}>
  <div class="species-detail-page">
    <div class="breadcrumb">
      <a href={siteUrl("/")}>ホーム</a><span>›</span>
      <a href={siteUrl("/species/")}>生きものから探す</a><span>›</span>
      <span>{speciesGroupBreadcrumb}</span><span>›</span>
      {speciesName}
    </div>

    <section class="species-detail-hero">
      <p class="eyebrow">{speciesGroup}</p>
      <h1>{speciesName}</h1>
    </section>

    <section class="species-detail-section">
      <h2>{speciesName}のフィギュア</h2>
      <p class="species-detail-count">{figures.length}種類のフィギュア</p>
      <FigureCardGrid figures={figures} />
    </section>
  </div>
</BaseLayout>
