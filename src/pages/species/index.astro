---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { resolveFigureImage } from "../../lib/figure-images";
import {
  getSpeciesEntries,
  getSpeciesGroups,
  getSpeciesTaxonomy,
  getSpeciesTaxonomyGroups,
  getSpeciesTaxonomyPathSegment,
  type SpeciesTaxonomyNode
} from "../../lib/species";
import { siteUrl } from "../../lib/site-url";

const entries = await getCollection("figures");
const figures = entries.filter(
  (item) => item.data.contentType !== "title" && getSpeciesEntries(item.data).length > 0
);
type Figure = (typeof figures)[number];
const taxonomy = getSpeciesTaxonomy();
const speciesGroups = getSpeciesGroups();

const belongsToNode = (figure: Figure, node: SpeciesTaxonomyNode) => {
  const groups = getSpeciesTaxonomyGroups(node);
  return getSpeciesEntries(figure.data).some((entry) =>
    (node.species ?? []).includes(entry.species) ||
    groups.some((group) =>
      entry.speciesGroup === group || entry.speciesGroup.startsWith(`${group}/`)
    )
  );
};
const figuresForNode = (node: SpeciesTaxonomyNode) => figures.filter((figure) => belongsToNode(figure, node));

const imageForFigure = (figure: Figure) => {
  const refs = [
    figure.data.coverImage,
    ...figure.data.topics.flatMap((topic) => topic.images)
  ];
  return refs
    .map((ref) => resolveFigureImage(figure.id, ref))
    .find((image) => image !== undefined);
};

const imageForNode = (node: SpeciesTaxonomyNode) => {
  const selectedIds = [
    node.imageFigureId,
    ...getSpeciesTaxonomyGroups(node).map((group) => speciesGroups[group]?.imageFigureId)
  ].filter((id): id is string => Boolean(id));
  const selected = selectedIds
    .map((id) => figures.find((figure) => figure.id.replace(/\/index(?:\.md)?$/, "") === id))
    .find((figure) => figure !== undefined);
  if (selected) {
    const image = imageForFigure(selected);
    if (image) return image;
  }
  return figuresForNode(node).map(imageForFigure).find((image) => image !== undefined);
};

const speciesForNode = (node: SpeciesTaxonomyNode) =>
  Array.from(new Set([
    ...(node.species ?? []),
    ...figuresForNode(node).flatMap((figure) =>
      getSpeciesEntries(figure.data)
        .filter((entry) =>
          getSpeciesTaxonomyGroups(node).some((group) =>
            entry.speciesGroup === group || entry.speciesGroup.startsWith(`${group}/`)
          )
        )
        .map((entry) => entry.species)
    )
  ]));
---

<BaseLayout title="SPECIES | NATURE FIGURE">
  <div class="species-page">
    <div class="breadcrumb"><a href={siteUrl("/")}>ホーム</a> / 生きものから探す</div>

    <section class="species-hero">
      <div class="species-hero-copy">
        <h1>生き物から探す</h1>
        <p>
          フィギュアに登場する生き物を、分類や名前から探すことができます。<br />
          動物・古生物・幻獣・伝承のカテゴリから、気になる生き物を見つけてください。
        </p>
      </div>
      <div class="species-hero-art" aria-hidden="true">♠</div>
    </section>

    <form class="species-search" id="species-search">
      <span aria-hidden="true">⌕</span>
      <label class="sr-only" for="species-query">生き物の名前で検索</label>
      <input id="species-query" type="search" placeholder="生き物の名前で検索（例：ニホンザル、ティラノサウルスなど）" />
      <button type="submit">検索</button>
    </form>
    <p class="species-search-status" id="species-search-status" aria-live="polite"></p>

    <div class="species-category-list">
      {Object.entries(taxonomy).map(([title, root]) => (
        <section class:list={["species-category", `species-category--${root.id ?? "species"}`]}>
          <div class="species-category-intro">
            <div class="species-category-icon" aria-hidden="true">{root.icon ?? "●"}</div>
            <div>
              <h2>{title}</h2>
              {root.englishTitle && <p class="species-category-english">{root.englishTitle}</p>}
              {root.description && <p class="species-category-description">{root.description}</p>}
            </div>
          </div>
          <div class="species-group-grid">
            {Object.entries(root.categories ?? {}).map(([name, node]) => {
              const image = imageForNode(node);
              const species = speciesForNode(node);
              return (
                <a
                  class="species-group-card"
                  href={siteUrl(`/species/${encodeURIComponent(getSpeciesTaxonomyPathSegment(title))}/${encodeURIComponent(getSpeciesTaxonomyPathSegment(name))}/`)}
                  data-species={`${name} ${species.join(" ")}`}
                >
                  {image ? <img src={image} alt="" loading="lazy" /> : <span class="species-group-placeholder" data-label={name.toUpperCase()} aria-hidden="true" />}
                  <span class="species-group-content">
                    <strong>{name}</strong>
                    <span class="species-group-arrow" aria-hidden="true">›</span>
                  </span>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#species-search");
  const input = document.querySelector<HTMLInputElement>("#species-query");
  const status = document.querySelector<HTMLElement>("#species-search-status");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".species-group-card"));

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const query = input?.value.trim().toLocaleLowerCase() ?? "";
    let visible = 0;
    cards.forEach((card) => {
      const matches = !query || (card.dataset.species ?? "").toLocaleLowerCase().includes(query);
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (status) status.textContent = query && visible === 0 ? "該当する分類が見つかりませんでした。" : "";
  });
</script>
