---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { resolveFigureImage } from "../../lib/figure-images";
import { siteUrl } from "../../lib/site-url";

const entries = await getCollection("figures");
const figures = entries.filter(
  (item) => item.data.contentType !== "title" && item.data.species
);

type Figure = (typeof figures)[number];
type Group = {
  id?: string;
  name: string;
  species: string[];
};
type Category = {
  id: string;
  title: string;
  englishTitle: string;
  description: string;
  icon: string;
  groups: Group[];
};

const categories: Category[] = [
  {
    id: "animal",
    title: "動物",
    englishTitle: "ANIMAL",
    description: "現在生きている生き物を、分類から探すことができます。",
    icon: "●",
    groups: [
      { id: "mammals", name: "哺乳類", species: ["ニホンザル", "トウホクノウサギ"] },
      { id: "birds", name: "鳥類", species: ["マガン", "オオマシコ"] },
      { id: "reptiles", name: "爬虫類", species: [] },
      { id: "amphibians", name: "両生類", species: ["トウホクサンショウウオ"] },
      { id: "fish", name: "魚類", species: ["クニマス"] },
      { id: "insects", name: "昆虫", species: [] },
      { id: "crustaceans", name: "甲殻類", species: ["ニホンザリガニ"] },
      { id: "other-arthropods", name: "その他節足動物", species: [] },
      { id: "mollusks", name: "軟体動物", species: [] },
      { id: "other", name: "その他", species: ["キタカブリ"] }
    ]
  },
  {
    id: "paleontology-dinosaurs",
    title: "古生物 - 恐竜とその仲間",
    englishTitle: "PALEONTOLOGY / DINOSAURS & RELATIVES",
    description: "恐竜とその仲間を、分類から探すことができます。",
    icon: "✦",
    groups: [
      { id: "theropods", name: "獣脚類", species: [] },
      { id: "sauropods", name: "竜脚類", species: [] },
      { id: "ornithopods", name: "鳥脚類", species: [] },
      { id: "ceratopsians", name: "角竜類", species: [] },
      { id: "thyreophorans", name: "装盾類", species: [] },
      { id: "pachycephalosaurs", name: "堅頭竜類", species: [] },
      { id: "pterosaurs", name: "翼竜", species: [] },
      { id: "marine-reptiles", name: "海生爬虫類", species: [] },
      { id: "other-dinosaurs", name: "その他", species: [] }
    ]
  },
  {
    id: "paleontology-other",
    title: "古生物 - その他",
    englishTitle: "OTHER PALEONTOLOGY",
    description: "恐竜以外の絶滅した生き物を探すことができます。",
    icon: "◉",
    groups: [
      { id: "paleontology-ancient-mammals", name: "古代の哺乳類", species: [] },
      { id: "paleontology-ancient-fish", name: "古代の魚類", species: [] },
      { id: "paleontology-ancient-amphibians", name: "古代の両生類", species: [] },
      { id: "paleontology-ancient-reptiles", name: "古代の爬虫類", species: [] },
      { id: "paleontology-ancient-arthropods", name: "古代の節足動物", species: [] },
      { id: "paleontology-other", name: "その他", species: [] }
    ]
  },
  {
    id: "mythical",
    title: "幻獣・伝承",
    englishTitle: "MYTHICAL & LEGENDARY",
    description: "伝承や神話、都市伝説に登場する生き物を探すことができます。",
    icon: "♞",
    groups: [
      { name: "UMA", species: ["ツチノコ"] },
      { name: "妖怪", species: [] },
      { name: "幻獣", species: [] },
      { name: "キャラクター", species: [] }
    ]
  }
];

const figureForSpecies = (names: string[]): Figure | undefined =>
  figures.find((figure) => names.includes(figure.data.species ?? ""));

const imageForFigure = (figure: Figure) => {
  const imageRefs = [
    figure.data.coverImage,
    ...figure.data.topics.flatMap((topic) => topic.images)
  ];
  const figureImage = imageRefs
    .map((ref) => resolveFigureImage(figure.id, ref))
    .find((image) => image !== undefined);
  if (figureImage) return figureImage;

  const figureId = figure.id.replace(/\/index(?:\.md)?$/, "");
  const title = entries.find(
    (entry) =>
      entry.data.contentType === "title" &&
      (
        entry.data.figureIds.some(
          (id) => id.replace(/\/index(?:\.md)?$/, "") === figureId
        ) ||
        (figure.data.titleId ?? "").replace(/\/index(?:\.md)?$/, "") ===
          entry.id.replace(/\/index(?:\.md)?$/, "")
      )
  );
  if (!title) return undefined;

  const titleImage = [title.data.collectionImage, title.data.coverImage]
    .map((ref) => resolveFigureImage(title.id, ref))
    .find((image) => image !== undefined);
  if (titleImage) return titleImage;

  return title.data.figureIds
    .map((id) => {
      const relatedFigure = figures.find(
        (item) => item.id.replace(/\/index(?:\.md)?$/, "") === id.replace(/\/index(?:\.md)?$/, "")
      );
      if (!relatedFigure) return undefined;

      return [
        relatedFigure.data.coverImage,
        ...relatedFigure.data.topics.flatMap((topic) => topic.images)
      ]
        .map((ref) => resolveFigureImage(relatedFigure.id, ref))
        .find((image) => image !== undefined);
    })
    .find((image) => image !== undefined);
};

const categoryPrefixes: Record<string, string[]> = {
  mammals: ["哺乳類", "霊長類"],
  birds: ["鳥類"],
  reptiles: ["爬虫類", "ヘビ類", "トカゲ類", "カメ類", "ワニ類"],
  amphibians: ["両生類","カエル類"],
  fish: ["魚類"],
  insects: [
    "昆虫",
    "カブトムシ・クワガタ類",
    "その他の甲虫類",
    "チョウ・ガ類",
    "ハチ・アリ類",
    "バッタ・コオロギ類",
    "カマキリ・ナナフシ類",
    "トンボ類",
    "その他昆虫"
  ],
  crustaceans: ["甲殻類"],
  "other-arthropods": [
    "その他節足動物",
    "クモ類",
    "ムカデ・ヤスデ類",
    "サソリ類"
  ],
  mollusks: ["軟体動物", "イカ類", "タコ類"],
  theropods: ["古生物/獣脚類"],
  sauropods: ["古生物/竜脚類"],
  ornithopods: ["古生物/鳥脚類"],
  ceratopsians: ["古生物/角竜類"],
  thyreophorans: ["古生物/装盾類"],
  pachycephalosaurs: ["古生物/堅頭竜類"],
  pterosaurs: ["古生物/翼竜"],
  "marine-reptiles": ["古生物/海生爬虫類"],
  "other-dinosaurs": ["古生物/その他"],
  "paleontology-ancient-mammals": ["古生物/古代の哺乳類", "古代の哺乳類"],
  "paleontology-ancient-fish": ["古生物/古代の魚類"],
  "paleontology-ancient-amphibians": ["古生物/古代の両生類"],
  "paleontology-ancient-reptiles": ["古生物/古代の爬虫類"],
  "paleontology-ancient-arthropods": ["古生物/古代の節足動物", "古代の節足動物"],
  "paleontology-other": ["古生物/未分類", "古生物/その他"]
};

const belongsToGroup = (figure: Figure, group: Group) => {
  const speciesGroup = figure.data.speciesGroup ?? "";
  const prefixes = group.id
    ? categoryPrefixes[group.id] ?? []
    : [group.name];
  return (
    group.species.includes(figure.data.species ?? "") ||
    prefixes.some((prefix) =>
      speciesGroup === prefix || speciesGroup.startsWith(`${prefix}/`)
    )
  );
};

const groupFigures = (group: Group) => figures.filter((figure) => belongsToGroup(figure, group));

const groupImage = (group: Group) => {
  const candidates = [...groupFigures(group)];
  const example = figureForSpecies(group.species);
  if (example && !candidates.includes(example)) candidates.push(example);
  return candidates.map(imageForFigure).find((image) => image !== undefined);
};

const placeholderLabels: Record<string, string> = {
  mammals: "MAMMALS",
  birds: "BIRDS",
  reptiles: "REPTILES",
  amphibians: "AMPHIBIANS",
  fish: "FISH",
  insects: "INSECTS",
  crustaceans: "CRUSTACEANS",
  "other-arthropods": "ARTHROPODS",
  mollusks: "MOLLUSKS",
  theropods: "THEROPODS",
  sauropods: "SAUROPODS",
  ornithopods: "ORNITHOPODS",
  ceratopsians: "CERATOPSIANS",
  thyreophorans: "THYREOPHORANS",
  pachycephalosaurs: "PACHYCEPHALOSAURS",
  pterosaurs: "PTEROSAURS",
  "marine-reptiles": "MARINE REPTILES",
  "other-dinosaurs": "DINOSAURS",
  "paleontology-ancient-mammals": "ANCIENT MAMMALS",
  "paleontology-ancient-fish": "ANCIENT FISH",
  "paleontology-ancient-amphibians": "ANCIENT AMPHIBIANS",
  "paleontology-ancient-reptiles": "ANCIENT REPTILES",
  "paleontology-ancient-arthropods": "ANCIENT ARTHROPODS",
  "paleontology-other": "PALEONTOLOGY",
  other: "OTHER"
};
---

<BaseLayout title="SPECIES | NATURE FIGURE">
  <div class="species-page">
    <div class="breadcrumb"><a href={siteUrl("/")}>ホーム</a> / 生きものから探す</div>

    <section class="species-hero">
      <div class="species-hero-copy">
        <p class="eyebrow">生きものから探す</p>
        <h1>生き物から探す</h1>
        <p>
          フィギュアに登場する生き物を、分類や名前から探すことができます。<br />
          動物・古生物・幻獣・伝承の4つのカテゴリから、気になる生き物を見つけてください。
        </p>
      </div>
      <div class="species-hero-art" aria-hidden="true">♠</div>
    </section>

    <form class="species-search" id="species-search">
      <span aria-hidden="true">⌕</span>
      <label class="sr-only" for="species-query">生き物の名前で検索</label>
      <input id="species-query" type="search" placeholder="生き物の名前で検索（例：ニホンザル、ティラノサウルスなど）" />
      <button type="submit">検索</button>
    </form>
    <p class="species-search-status" id="species-search-status" aria-live="polite"></p>

    <div class="species-category-list">
      {categories.map((category) => (
        <section class:list={["species-category", `species-category--${category.id}`]}>
          <div class="species-category-intro">
            <div class="species-category-icon" aria-hidden="true">{category.icon}</div>
            <div>
              <h2>{category.title}</h2>
              <p class="species-category-english">{category.englishTitle}</p>
              <p class="species-category-description">{category.description}</p>
            </div>
          </div>
          <div class="species-group-grid">
            {category.groups.map((group) => {
              const image = groupImage(group);
              const placeholderLabel = group.id ? placeholderLabels[group.id] ?? "SPECIES" : "LEGENDARY";
              return (
                <a
                  class="species-group-card"
                  href={siteUrl(group.id ? `/species/${group.id}/` : "/figures/")}
                  data-species={`${group.name} ${group.species.join(" ")}`}
                >
                  {image ? <img src={image} alt="" loading="lazy" /> : <span class="species-group-placeholder" data-label={placeholderLabel} aria-hidden="true" />}
                  <span class="species-group-content">
                    <strong>{group.name}</strong>
                    <span class="species-group-arrow" aria-hidden="true">›</span>
                  </span>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#species-search");
  const input = document.querySelector<HTMLInputElement>("#species-query");
  const status = document.querySelector<HTMLElement>("#species-search-status");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".species-group-card"));

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const query = input?.value.trim().toLocaleLowerCase() ?? "";
    let visible = 0;
    cards.forEach((card) => {
      const matches = !query || (card.dataset.species ?? "").toLocaleLowerCase().includes(query);
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (status) status.textContent = query && visible === 0 ? "該当する分類が見つかりませんでした。" : "";
  });
</script>
