---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { resolveFigureImage } from "../../lib/figure-images";
import { siteUrl } from "../../lib/site-url";

const figures = (await getCollection("figures")).filter(
  (item) => item.data.contentType !== "title" && item.data.species
);
const primates = figures.filter((figure) => figure.data.speciesGroup === "霊長類");
const imageFor = (figure: (typeof figures)[number]) =>
  resolveFigureImage(
    figure.id,
    figure.data.coverImage ?? figure.data.topics.flatMap((topic) => topic.images)[0]
  );
const speciesHref = (species: string) => siteUrl(`/species/${encodeURIComponent(species)}/`);
const speciesEntries = Array.from(
  new Map(primates.map((figure) => [figure.data.species, figure])).values()
);
const countForSpecies = (species: string) =>
  primates.filter((figure) => figure.data.species === species).length;
const featured = speciesEntries.slice(0, 3);
---

<BaseLayout title="霊長類 | NATURE FIGURE">
  <div class="primates-page">
    <div class="breadcrumb">
      <a href={siteUrl("/")}>ホーム</a><span>›</span>
      <a href={siteUrl("/species/")}>生きものから探す</a><span>›</span>
      <a href={siteUrl("/species/mammals/")}>哺乳類</a><span>›</span>
      霊長類
    </div>

    <section class="primates-hero">
      <div class="primates-hero-copy">
        <h1>霊長類</h1>
        <p>霊長類のフィギュアを、<br />生き物の種類から探せます。</p>
      </div>
      <div class="primates-hero-art" aria-hidden="true">♘</div>
    </section>

    <section class="primates-section">
      <h2>★ 注目の種</h2>
      <div class="primates-featured">
        {featured.length > 0 ? featured.map((figure) => (
          <a class="primate-feature-card" href={speciesHref(figure.data.species ?? "")}>
            <img src={imageFor(figure)} alt="" loading="lazy" />
            <div class="primate-feature-body">
              <strong>{figure.data.title}</strong>
              <small>♟ フィギュア {countForSpecies(figure.data.species ?? "")}種</small>
              <span aria-hidden="true">›</span>
            </div>
          </a>
        )) : <p class="primates-empty">現在、登録されている霊長類のフィギュアはありません。</p>}
      </div>
    </section>

    <section class="primates-section primates-list-section">
      <h2>☷ 霊長類の種一覧</h2>
      <div class="primate-list">
        {speciesEntries.map((figure) => (
          <a class="primate-list-item" href={speciesHref(figure.data.species ?? "")}>
            <img src={imageFor(figure)} alt="" loading="lazy" />
            <span>
              <strong>{figure.data.title}</strong>
              <small>フィギュア {countForSpecies(figure.data.species ?? "")}種</small>
            </span>
            <span class="primate-list-arrow" aria-hidden="true">›</span>
          </a>
        ))}
      </div>
      {primates.length === 0 && <p class="primates-empty">現在、登録されている霊長類のフィギュアはありません。</p>}
    </section>
  </div>
</BaseLayout>
