---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import { getSortedCollection as getCollection } from "../../lib/content";
import { siteUrl } from "../../lib/site-url";
const items = await getCollection("works");
---
<BaseLayout title="WORKS | NATURE FIGURE">
  <div class="species-page">
    <div class="breadcrumb"><a href={siteUrl("/")}>ホーム</a> / 自作・塗装・改造</div>

    <section class="species-hero">
      <div class="species-hero-copy">
        <h1>自作・塗装・改造</h1>
        <p>自作や塗装、改造をしたフィギュア作品を紹介します。</p>
      </div>
    </section>

    <div class="grid">
      {items.map((item) => (
        <Card href={siteUrl(`/works/${item.id}/`)} label={item.data.type.toUpperCase()} title={item.data.title} description={item.data.description} image={item.data.images[0]} />
      ))}
    </div>
  </div>
</BaseLayout>
