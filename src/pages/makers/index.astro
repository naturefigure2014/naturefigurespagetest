---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSortedCollection as getCollection } from "../../lib/content";
import { resolveFigureImage } from "../../lib/figure-images";
import { siteUrl } from "../../lib/site-url";

const figures = await getCollection("figures");
const normalizeId = (id: string) => id.replace(/\/index(?:\.md)?$/, "");
const titleEntries = new Map(
  figures
    .filter((entry) => entry.data.contentType === "title")
    .map((entry) => [normalizeId(entry.id), entry])
);
const seriesNamesOf = (entry?: (typeof figures)[number]) => {
  const value = entry?.data.seriesName;
  if (!value) return [];
  return Array.isArray(value) ? value : [value];
};

type Pickup = { title: string; id?: string; href?: string; imageSourceId?: string; image?: string | number };
type Maker = { name: string; english: string; href?: string; pickups: Pickup[] };

const makers: Maker[] = [
  { name: "海洋堂", english: "KAIYODO", href: "/makers/kaiyodo/", pickups: [
    { title: "水生生物モデルコレクションAQUALAND", href: "/makers/kaiyodo/aqualand/", imageSourceId: "kaiyodo/aqualand", image: "img/aqualand_header.png" },
    { title: "日本の動物コレクション1", id: "kaiyodo/animatales/anima_jap1" },
    { title: "DINOLAND", id: "kaiyodo/dinoland", href: "/makers/kaiyodo/dinoland/" },
    { title: "カプセルQミュージアム", id: "kaiyodo/capsuleq", href: "/makers/kaiyodo/capsuleq/" , imageSourceId: "kaiyodo/animatales/anima_japI", image: "img/japIall.jpg" }
  ] },
  { name: "ユージン・タカラトミーアーツ", english: "YUJIN / TAKARA TOMY A.R.T.S", href: "/makers/TTA_yujin/TTA_yujin/", pickups: [
    { title: "原色淡水魚図鑑I", id: "yujin/tannsuigyo1" },
    { title: "原色日本昆虫図鑑I", id: "yujin/konntyu1" },
    { title: "立体カプセル百科事典 ハンティング・トロフィー", id: "yujin/hunting1" },
    { title: "不思議生物大百科 深淵の居住者 深海生物", id: "tta/deep_sea_creatures" }
  ] },
  { name: "いきもん", english: "IKIMON", href: "/makers/ikimon/ikimon/", pickups: [
    { title: "ネイチャーテクニカラー 日本のカエル", id: "ikimon/daiza/kaeru", href: "/makers/ikimon/ikimon/" },
    { title: "ネイチャーテクニカラー 海洋1", id: "ikimon/daiza/kaiyo1" },
    { title: "サイエンステクニカラー ドイツ箱", id: "ikimon/STC/specimenbox4" },
    { title: "ネイチャーテクニカラー 日本のカメ", id: "ikimon/daiza/nihonn_kame" }
  ] },
  { name: "バンダイ", english: "BANDAI", href: "/makers/BANDAI/BANDAI/", pickups: [
    { title: "いきもの大図鑑 アドバンス ヘラクレスオオカブト", id: "BANDAI/ikimono_advance/hercules_advance" },
    { title: "いきもの大図鑑 ディスプレイモデルコレクション 恐竜03", id: "BANDAI/ikimono_dispay/kyoryu03" },
    { title: "いきもの大図鑑プレミアム ヘラクレス", id: "BANDAI/ikimono_premium/hercules" },
  ] },
  { name: "スタジオソータ", english: "STUDIO SOTA", pickups: [
    { title: "いきものフィギュアコレクション" }, { title: "ミニチュア自然観察" },
    { title: "動物園のなかまたち" }
  ] },
  { name: "エポック社", english: "EPOCH", pickups: [
    { title: "シルバニアファミリー" }, { title: "どうぶつコレクション" },
    { title: "森のなかまたち" }
  ] },
  { name: "その他", english: "OTHER MAKERS", pickups: [
    { title: "メーカー別ピックアップ" },
    { title: "気になるタイトル" }, { title: "新着フィギュア" }
  ] }
];
---
<BaseLayout title="MAKERS & TITLES | NATURE FIGURE">
  <div class="maker-directory">
    <div class="breadcrumb"><a href={siteUrl("/")}>ホーム</a> / メーカー・タイトルから探す</div>
    <section class="maker-directory-hero">
      <h1>メーカー・タイトルから探す</h1>
      <p>メーカーやフィギュアのタイトルから探すことができます。</p>
    </section>
    <div class="maker-search" aria-label="メーカー・タイトル検索">
      <span aria-hidden="true">⌕</span>
      <input type="search" placeholder="メーカー名・タイトル名で検索" />
    </div>
    <div class="maker-directory-list">
      {makers.map((maker) => (
        <section class="maker-directory-section">
          <header class="maker-directory-heading">
            <div><h2>{maker.name}</h2><p>{maker.english}</p></div>
            <a href={siteUrl(maker.href ?? "/titles/")}>このメーカーのタイトル一覧を見る <span>→</span></a>
          </header>
          <div class="maker-pickup-grid">
            {maker.pickups.map((pickup) => {
              const entry = pickup.id ? titleEntries.get(normalizeId(pickup.id)) : undefined;
              const image = pickup.imageSourceId
                ? resolveFigureImage(pickup.imageSourceId, pickup.image)
                : entry
                  ? resolveFigureImage(entry.id, entry.data.coverImage)
                  : undefined;
              const seriesNames = seriesNamesOf(entry);
              const card = (
                <>
                  {image ? <img src={image} alt="" loading="lazy" /> : <div class="maker-pickup-placeholder">{maker.name}</div>}
                  <span class="maker-pickup-caption">
                    <strong>{entry?.data.title ?? pickup.title}</strong>
                    {seriesNames.length > 0 && (
                      <span class="maker-pickup-series">
                        {seriesNames.map((name) => <small>{name}</small>)}
                      </span>
                    )}
                  </span>
                  <span class="maker-pickup-arrow">›</span>
                </>
              );
              const pickupHref = pickup.href
                ? siteUrl(pickup.href)
                : entry
                  ? siteUrl(`/figures/${normalizeId(entry.id)}/`)
                  : undefined;
              return pickupHref
                ? <a class="maker-pickup-card" href={pickupHref}>{card}</a>
                : <div class="maker-pickup-card">{card}</div>;
            })}
          </div>
        </section>
      ))}
    </div>
    <p class="maker-directory-note">※ 掲載するタイトルは、サイトの内容に合わせて後から自由に差し替えられます。</p>
  </div>
</BaseLayout>
