---
import "../../../styles/global.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import MakerCardBadges from "../../../components/MakerCardBadges.astro";
import { getCollection, render } from "astro:content";
import { resolveFigureImage } from "../../../lib/figure-images";
import { siteUrl } from "../../../lib/site-url";

export async function getStaticPaths() {
  const makerPages = await getCollection("makers");
  return makerPages
    .filter((entry) => entry.data.seriesPageSlug)
    .map((entry) => ({
      params: { series: entry.data.seriesPageSlug },
      props: { entry }
    }));
}

const { entry: page } = Astro.props;
const { Content } = await render(page);
if (!page.data.titleSeries) throw new Error(`Missing titleSeries for maker series page: ${page.id}`);

const figures = await getCollection("figures");
const normalizeId = (id: string) => id.replace(/\/index(?:\.md)?$/, "");
const entryById = new Map(figures.map((item) => [normalizeId(item.id), item]));
const seriesEntries = figures.filter((item) => {
  if (item.data.contentType !== "title") return false;
  const series = item.data.series;
  const seriesName = item.data.seriesName;
  return (Array.isArray(series) ? series : []).includes(page.data.titleSeries ?? "")
    || (Array.isArray(seriesName) ? seriesName : seriesName ? [seriesName] : []).includes(page.data.titleSeries ?? "");
});
const seriesNames = (entry: (typeof seriesEntries)[number]) => {
  const value = entry.data.seriesName;
  return value ? (Array.isArray(value) ? value : [value]) : [page.data.pageTitle ?? ""];
};
const titlesForSection = (section: (typeof page.data.seriesSections)[number]) => {
  if (section.titleIds.length > 0) {
    return section.titleIds
      .map((title) => entryById.get(normalizeId(typeof title === "string" ? title : title.id)))
      .filter((item): item is (typeof figures)[number] => item?.data.contentType === "title")
      .slice(0, section.maxTitles);
  }
  if (section.name === "すべて") {
    return seriesEntries.slice(0, section.maxTitles);
  }
  return seriesEntries
    .filter((item) => seriesNames(item).includes(section.name))
    .slice(0, section.maxTitles);
};
const badgesForTitle = (section: (typeof page.data.seriesSections)[number], titleId: string) => {
  const configuredTitle = section.titleIds.find((title) =>
    typeof title !== "string" && normalizeId(title.id) === normalizeId(titleId)
  );
  return typeof configuredTitle === "string" || !configuredTitle ? [] : configuredTitle.badges;
};
const heroSource = page.data.heroSourceId ? entryById.get(normalizeId(page.data.heroSourceId)) : undefined;
const heroImage = heroSource
  ? resolveFigureImage(heroSource.id, page.data.heroImage === "coverImage" ? heroSource.data.coverImage : page.data.heroImage)
  : undefined;
---

<BaseLayout title={`${page.data.pageTitle ?? "シリーズ"} | ${page.data.maker} | NATURE FIGURE`}>
  <div class="maker-detail">
    <div class="maker-detail-content">
      <div class="breadcrumb">
        <a href={siteUrl("/")}>ホーム</a> /
        <a href={siteUrl("/makers/")}>メーカー・タイトルから探す</a> /
        <a href={siteUrl("/makers/kaiyodo/")}>{page.data.maker}</a> /
        {page.data.pageTitle}
      </div>

      <div class="maker-detail-hero-wrap">
        <section class="maker-detail-hero maker-series-detail-hero">
          <div>
            <p class="maker-series-detail-maker">{page.data.maker}</p>
            <h1>{page.data.pageTitle}</h1>
            <p class="maker-series-detail-english">{page.data.pageEnglish}</p>
          </div>
          {heroImage && <img src={heroImage} alt="" />}
        </section>
      </div>

      <section class="maker-detail-description">
        <Content />
      </section>

      <section class="maker-detail-section maker-detail-section--flat">
        {page.data.seriesSections.map((section) => {
          const titles = titlesForSection(section);
          return (
            <section class="maker-detail-series">
              <header>
                <div><h2>{section.name}</h2>{section.format && <span>{section.format}</span>}</div>
              </header>
              {section.description && <p class="maker-detail-series-description">{section.description}</p>}
              <div class="maker-detail-title-grid">
                {section.cards.map((card) => {
                  const image = card.sourceId
                    ? resolveFigureImage(card.sourceId, card.image === "coverImage" ? entryById.get(normalizeId(card.sourceId))?.data.coverImage : card.image)
                    : undefined;
                  return (
                    <a class="maker-detail-card" href={card.href.startsWith("/") ? siteUrl(card.href) : card.href}>
                      {image ? <img src={image} alt="" /> : <span class="maker-detail-card-placeholder">FIGURE</span>}
                      {image && <MakerCardBadges badges={card.badges} />}
                      <strong>{card.name}</strong>
                    </a>
                  );
                })}
                {titles.map((title) => {
                  const image = resolveFigureImage(title.id, title.data.coverImage);
                  return (
                    <a class="maker-detail-card" href={siteUrl(`/figures/${normalizeId(title.id)}/`)}>
                      {image ? <img src={image} alt="" /> : <span class="maker-detail-card-placeholder">FIGURE</span>}
                      {image && <MakerCardBadges badges={badgesForTitle(section, title.id)} />}
                      <strong>{title.data.shortTitle || title.data.title}</strong>
                    </a>
                  );
                })}
              </div>
            </section>
          );
        })}
      </section>
    </div>
  </div>
</BaseLayout>
