---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSortedCollection as getCollection } from "../lib/content";
import { compareContentId } from "../lib/content-order.mjs";
import { resolveFigureImage } from "../lib/figure-images";
import { getSpeciesEntries } from "../lib/species";
import { makerNames } from "../lib/maker";
import { siteUrl } from "../lib/site-url";

const normalizeId = (id: string) => id.replace(/\/index(?:\.md)?$/, "");

const figures = await getCollection("figures");
const figureById = new Map(figures.map((item) => [normalizeId(item.id), item]));

const recentFigures = figures
  .filter((item) => item.data.date)
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0) || compareContentId(a, b))
  .slice(0, 5);

// TODO: 「注目のフィギュア」の選定ロジックが決まるまでの仮のピックアップ。
const featuredFigureIds = [
  "kaiyodo/aqualand/AQS009zinbezame",
  "kaiyodo/ARTPLA/Lion",
  "kaiyodo/ARTPLA/Tyrannosaurus"
];
const featuredFigures = featuredFigureIds
  .map((id) => figureById.get(id))
  .filter((item): item is (typeof figures)[number] => Boolean(item));

const categoryLabels: Record<string, string> = {
  diary: "日記",
  event: "イベント",
  outing: "施設・訪問",
  note: "その他"
};

const recentPosts = (await getCollection("blog"))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0) || compareContentId(a, b))
  .slice(0, 3);
---

<BaseLayout>
  <section class="home-hero">
    <img class="home-hero-image" src={siteUrl("/images/home-hero-placeholder.png")} alt="" />
    <div class="home-hero-overlay"></div>
    <div class="home-hero-content">
      <h1>ネイチャーフィギュアのページ</h1>
      <p class="lead">動物・魚・昆虫・恐竜など、<br />自然の魅力をカタチにした<br />フィギュアの世界へ。</p>
    </div>
  </section>

  {[
    { heading: "最近追加したフィギュア", items: recentFigures, recent: true },
    { heading: "注目のフィギュア", items: featuredFigures, recent: false }
  ].map(({ heading, items, recent }) => (
    <section class="home-section">
      <div class="home-section-heading">
        <span></span>
        <h2>{heading}</h2>
        <a href={siteUrl("/figures/")}>すべてのフィギュアを見る ›</a>
      </div>
      <div class:list={["home-figure-grid", { "home-figure-grid--recent": recent }]}>
        {items.map((item) => {
          const image = resolveFigureImage(
            item.id,
            item.data.coverImage ?? item.data.topics.flatMap((topic) => topic.images)[0]
          );
          const speciesGroups = recent && item.data.contentType === "title"
            ? []
            : Array.from(new Set(getSpeciesEntries(item.data).map((entry) => entry.speciesGroup)));
          return (
            <a class="home-figure-card" href={siteUrl(`/figures/${normalizeId(item.id)}/`)}>
              {image ? <img src={image} alt="" loading="lazy" /> : <span class="home-figure-placeholder">FIGURE</span>}
              <span class="home-figure-badge">NEW</span>
              <span class="home-figure-caption">
                <strong>{item.data.title}</strong>
                {(speciesGroups.length > 0 || item.data.maker) && <small>{speciesGroups.length > 0 ? speciesGroups.join("・") : makerNames(item.data.maker).join("・")}</small>}
                {recent && item.data.date && (
                  <time datetime={item.data.date.toISOString()}>{item.data.date.toISOString().slice(0, 10).replace(/-/g, "/")}</time>
                )}
              </span>
            </a>
          );
        })}
      </div>
    </section>
  ))}

  <section class="home-section">
    <div class="home-section-heading">
      <span></span>
      <h2>最近の記事／ブログ</h2>
      <a href={siteUrl("/blog/")}>すべての記事を見る ›</a>
    </div>
    <div class="home-blog-grid">
      {recentPosts.map((post) => (
        <a class="home-blog-card" href={siteUrl(`/blog/${post.id}/`)}>
          {post.data.coverImage ? (
            <img src={post.data.coverImage} alt="" loading="lazy" />
          ) : (
            <span class="home-blog-placeholder">NATURE<br />FIGURE</span>
          )}
          <span class="home-blog-body">
            <strong>{post.data.title}</strong>
            <span class="home-blog-meta">
              {post.data.date && (
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" })}
                </time>
              )}
              <span class="home-blog-tag">{categoryLabels[post.data.category] ?? post.data.category}</span>
            </span>
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
